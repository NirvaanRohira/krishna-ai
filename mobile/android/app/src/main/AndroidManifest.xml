<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only what's needed now. The microphone (voice mode) is added with that screen, and is
         asked for in context, with the app still working if the person says no. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No cloud backup or device transfer of app data: sign-in tokens must not leave the phone. -->
    <application
        android:name=".KanhaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kanha.Starting">
        <!-- The launcher screen must be exported (Android 12+), or the home screen can't open the
             app. It takes no data from the launching app and has no privileged actions. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Fallback sign-in (through the website) comes back as kanha://auth?code=…. The code
                 alone is useless: it only works with the PKCE verifier this app kept (AppGraph). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kanha" android:host="auth" />
            </intent-filter>
        </activity>
    </application>
</manifest>
